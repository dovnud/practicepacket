---
import Base from '../layouts/Base.astro'
const description = 'Terms for using Practice Packet worksheets in class and at home.'
---
<Base title="Terms | Practice Packet" description={description} path="/terms/">
  <div class="prose">
  <h1>Terms</h1>
  <p>You may print Practice Packet worksheets and use them in a classroom, a tutoring session, or at home, free of charge. You may not sell the files, post the PDF as your own product, or copy the pages onto another site.</p>
  <p>The problems are generated for this site. Answer keys match the problems on that page. If you use the new-numbers button, the on-screen set changes and the downloaded PDF does not.</p>
  <p>Standards codes are citations. The wording of each skill is ours. See the standards notice for the Common Core copyright line.</p>
  <p>The pages are provided as practice, not as a complete curriculum and not as an official state test. Contact <a href="mailto:contact@practicepacket.com">contact@practicepacket.com</a> about a correction.</p>
  </div>
</Base>
