---
import Base from '../../../layouts/Base.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import { breadcrumbLd } from '../../../lib/catalog.ts'
import { GRADE_LABEL, GRADE_TONE, SUBJECT_LABEL, gradesWithSkills, skillsFor, subjectsFor, topicsFor, type GradeId, type SubjectId } from '../../../lib/skills.ts'

export function getStaticPaths() {
  const paths = []
  for (const grade of gradesWithSkills()) {
    for (const subject of subjectsFor(grade)) {
      paths.push({ params: { grade, subject }, props: { grade, subject } })
    }
  }
  return paths
}
interface Props { grade: GradeId; subject: SubjectId }
const { grade, subject } = Astro.props
const topics = topicsFor(grade, subject).map((topic) => ({
  ...topic,
  count: skillsFor(grade, subject, topic.topic).length,
}))
const path = `/grade-${grade}/${subject}/`
const title = `${GRADE_LABEL[grade]} ${SUBJECT_LABEL[subject]} | Practice Packet`
const description = `${GRADE_LABEL[grade]} ${SUBJECT_LABEL[subject].toLowerCase()} topics, each linking to a single-skill worksheet.`
const tone = GRADE_TONE
---
<Base title={title} description={description} path={path} jsonld={breadcrumbLd([
  { name: 'Home', path: '/' },
  { name: GRADE_LABEL[grade], path: `/grade-${grade}/` },
  { name: SUBJECT_LABEL[subject], path },
])}>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: GRADE_LABEL[grade], href: `/grade-${grade}/` },
    { label: SUBJECT_LABEL[subject] },
  ]} />
  <div class="page-intro">
    <h1>{GRADE_LABEL[grade]} {SUBJECT_LABEL[subject]}</h1>
  </div>
  <div class="cards">
    {topics.map((topic) => (
      <a class="card" href={`${path}${topic.topic}/`} style={`--grade:${tone[grade]}`}>
        <span class="chip">{topic.count}</span>
        <h2>{topic.label}</h2>
        <p>{topic.count === 1 ? '1 skill' : `${topic.count} skills`}</p>
      </a>
    ))}
  </div>
</Base>
