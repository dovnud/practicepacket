---
import Base from '../../../../layouts/Base.astro'
import Breadcrumbs from '../../../../components/Breadcrumbs.astro'
import AdSlot from '../../../../components/AdSlot.astro'
import { breadcrumbLd } from '../../../../lib/catalog.ts'
import { sheet } from '../../../../lib/generate.ts'
import { renderAnswers, renderSheet } from '../../../../lib/render.ts'
import {
  GRADE_LABEL,
  LEVELS,
  byId,
  pdfHref,
  publishedSkills,
  skillPath,
  type Skill,
} from '../../../../lib/skills.ts'

export function getStaticPaths() {
  return publishedSkills().map((skill) => ({
    params: {
      grade: skill.grade,
      subject: skill.subject,
      topic: skill.topic,
      skill: skill.slug,
    },
    props: { skill },
  }))
}

interface Props { skill: Skill }
const { skill } = Astro.props
const path = skillPath(skill)
const title = `${skill.title}, ${GRADE_LABEL[skill.grade]} | Practice Packet`
const sheets = Object.fromEntries(LEVELS.map((level) => [level, sheet(skill, level, 0)]))
const visibleRelated = skill.related
  .map((id) => byId(id))
  .filter((s): s is Skill => !!s && publishedSkills().some((p) => p.id === s.id))
const crumbs = [
  { label: 'Home', href: '/' },
  { label: GRADE_LABEL[skill.grade], href: `/grade-${skill.grade}/` },
  { label: 'Math', href: `/grade-${skill.grade}/math/` },
  { label: skill.topicLabel, href: `/grade-${skill.grade}/math/${skill.topic}/` },
  { label: skill.title },
]
const ld = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: GRADE_LABEL[skill.grade], path: `/grade-${skill.grade}/` },
    { name: 'Math', path: `/grade-${skill.grade}/math/` },
    { name: skill.topicLabel, path: `/grade-${skill.grade}/math/${skill.topic}/` },
    { name: skill.title, path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: skill.title,
    description: skill.description,
    learningResourceType: 'Worksheet',
    educationalLevel: GRADE_LABEL[skill.grade],
    teaches: skill.standard.summary,
    isAccessibleForFree: true,
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: 'Practice Packet', url: 'https://practicepacket.com' },
  },
]
const payload = JSON.stringify({ id: skill.id, spec: skill.spec }).replaceAll('<', '\\u003c')
---
<Base title={title} description={skill.description} path={path} jsonld={ld} batch={skill.batch}>
  <Breadcrumbs items={crumbs} />
  <p class="standard">Common Core {skill.standard.code}</p>
  <h1>{skill.title}</h1>
  <p class="lede">{skill.explanation}</p>
  <section class="example">
    <h2>One worked example</h2>
    <p>{skill.example.story}</p>
    <ol>
      {skill.example.steps.map((step) => <li>{step}</li>)}
    </ol>
    <p><strong>Answer: {skill.example.answer}</strong></p>
  </section>
  <p class="muted">{skill.standard.summary}</p>
  <AdSlot />
  {LEVELS.map((level) => (
    <section class="level" id={level} data-level={level}>
      <h2>{level[0].toUpperCase() + level.slice(1)}</h2>
      <p>{skill.direction}</p>
      <div class="actions no-print">
        <button type="button" data-regen data-level={level}>New numbers</button>
        <button type="button" class="secondary" data-print data-level={level}>Print this level</button>
<a class="button secondary" href={pdfHref(skill, level)}>Download PDF</a>
        </div>
      <div class="sheet" data-sheet={level} set:html={renderSheet(sheets[level])} />
      <details>
        <summary>Answer key</summary>
        <div data-key={level} set:html={renderAnswers(sheets[level])} />
      </details>
    </section>
  ))}
  {visibleRelated.length > 0 && (
    <section>
      <h2>Related skills</h2>
      <ul>
        {visibleRelated.map((item) => (
          <li><a href={skillPath(item)}>{item.title}, {GRADE_LABEL[item.grade]}</a></li>
        ))}
      </ul>
    </section>
  )}
  <script id="skill-spec" type="application/json" set:html={payload} />
  <p class="muted no-print">The new-numbers button needs JavaScript. The downloaded PDF stays the original set, so a link you share does not change.</p>
</Base>
<script>
  import { makeProblems } from '../../../../lib/generate.ts'
  import { renderAnswers, renderSheet } from '../../../../lib/render.ts'
  import type { Level, Spec } from '../../../../lib/types.ts'

  const raw = document.getElementById('skill-spec')?.textContent
  if (raw) {
    const data = JSON.parse(raw) as { id: string; spec: Spec }
    const counts: Record<Level, number> = { easy: 1, medium: 1, hard: 1 }
    document.querySelectorAll<HTMLButtonElement>('[data-regen]').forEach((button) => {
      button.addEventListener('click', () => {
        const level = button.dataset.level as Level
        const problems = makeProblems(data.spec, level, hash(`${data.id}:${level}:${counts[level]++}`))
        const sheet = document.querySelector<HTMLElement>(`[data-sheet="${level}"]`)
        const key = document.querySelector<HTMLElement>(`[data-key="${level}"]`)
        if (sheet) sheet.innerHTML = renderSheet(problems)
        if (key) key.innerHTML = renderAnswers(problems)
      })
    })
    document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((button) => {
      button.addEventListener('click', () => {
        document.body.dataset.printLevel = button.dataset.level || ''
        window.print()
        delete document.body.dataset.printLevel
      })
    })
  }

  function hash(text: string): number {
    let h = 2166136261
    for (let i = 0; i < text.length; i++) {
      h ^= text.charCodeAt(i)
      h = Math.imul(h, 16777619)
    }
    return h >>> 0
  }
</script>
<style is:global>
  @media print {
    body[data-print-level] .level { display: none !important; }
    body[data-print-level="easy"] .level[data-level="easy"],
    body[data-print-level="medium"] .level[data-level="medium"],
    body[data-print-level="hard"] .level[data-level="hard"] { display: block !important; }
  }
</style>
