---
import { GRADE_LABEL, gradesWithSkills } from '../lib/skills.ts'
import { liveSeasons } from '../lib/catalog.ts'
const grades = gradesWithSkills()
const seasons = liveSeasons()
---
<header class="site">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="/">Practice Packet <small>Printable K–5 math</small></a>
    </div>
    <nav aria-label="Primary">
      <ul>
        {grades.map((g) => (
          <li><a href={`/grade-${g}/`}>{GRADE_LABEL[g]}</a></li>
        ))}
        {seasons.length > 0 && <li><a href="/seasons/">Seasons</a></li>}
        <li><a href="/standards/">Standards</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>
  </div>
</header>
