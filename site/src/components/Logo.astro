---
interface Props { word?: boolean }
const { word = true } = Astro.props
---
<span class="logo">
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="3" y="4" width="20" height="24" rx="5" fill="currentColor"/>
    <path d="M8 12h10M8 16.5h10M8 21h6" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M18 6.5l8 2.2v16.6l-8 2.2V6.5z" fill="#f5b942"/>
  </svg>
  {word && <span class="logo-word">Practice Packet</span>}
</span>
